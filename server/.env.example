# 复制为 server/.env 后填写；.env 已被 git 忽略，不要提交真实 Key。

# 解析引擎链：按顺序尝试，未配置或失败时降级（JSON 数组）
PARSER_CHAIN=["mineru_cloud","lite"]

# MinerU 云端：https://mineru.net/apiManage 创建 Token
MINERU_TOKEN=
# pipeline 或 vlm（vlm 公式效果更好）
MINERU_MODEL_VERSION=vlm

# 大模型（OpenAI 兼容 /chat/completions），三项都填才会启用；不填则只用规则拆题
# DeepSeek：  LLM_BASE_URL=https://api.deepseek.com/v1          LLM_MODEL=deepseek-chat
# 通义千问：  LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL=qwen-plus
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# 可选：附加到请求体的厂商参数（JSON），如通义千问关闭思考以加快速度
# LLM_EXTRA_BODY={"enable_thinking": false}

# 相似题语义检索（可选，不填只用字面相似度）；地址与 Key 默认沿用上面的大模型配置
# EMBEDDING_MODEL=text-embedding-v4
# 同时解析的试卷数（批量上传时其余排队）
# WORKER_CONCURRENCY=2

# 成本估算单价（可选，不填则只统计 token 与页数）。请以厂商官网价格为准。
# 大模型按模型名配置，单位：元 / 百万 tokens；cached_input 为缓存命中的输入单价（不填按 input 计）
# LLM_PRICES={"qwen-plus": {"input": 0.8, "output": 2, "cached_input": 0.16}}
# MinerU 单价，单位：元 / 页
# MINERU_PRICE_PER_PAGE=0.05
# CURRENCY=¥

# 可选：数据库（默认 server/data/app.db）、数据目录
# DATABASE_URL=postgresql+psycopg://user:pass@localhost/fg_quiz
# DATA_DIR=./data
