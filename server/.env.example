# 复制为 server/.env 后填写；.env 已被 git 忽略，不要提交真实 Key。

# 解析引擎链：按顺序尝试，未配置或失败时降级（JSON 数组）
PARSER_CHAIN=["mineru_cloud","lite"]
# Word（.docx）的解析链：docx 为本地解析（MathType / Word 公式转 LaTeX，秒级完成且不耗 MinerU 页数），
# 内容主要是图片、公式无法转换或识别不出题目时自动改用 MinerU
# DOCX_PARSER_CHAIN=["docx","mineru_cloud"]

# MinerU 云端：https://mineru.net/apiManage 创建 Token
MINERU_TOKEN=
# pipeline 或 vlm（vlm 公式效果更好）
MINERU_MODEL_VERSION=vlm

# 大模型（OpenAI 兼容 /chat/completions），三项都填才会启用；不填则只用规则拆题
# 腾讯云 TokenHub：LLM_BASE_URL=https://tokenhub.tencentmaas.com/v1  LLM_MODEL=deepseek/deepseek-v4-flash-vision-exp
# DeepSeek：  LLM_BASE_URL=https://api.deepseek.com/v1          LLM_MODEL=deepseek-chat
# 通义千问：  LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL=qwen-plus
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# 可选：附加到请求体的厂商参数（JSON），如通义千问关闭思考以加快速度（其他厂商可能不认该参数）
# LLM_EXTRA_BODY={"enable_thinking": false}

# 看图模型（可选）：AI 生成答案时，含配图的题改用该模型并附上图片；留空则大模型看不到图片
# 支持看图的模型可与 LLM_MODEL 相同，如 VISION_MODEL=deepseek/deepseek-v4-flash-vision-exp
# 通义千问：VISION_MODEL=qwen3-vl-plus（地址与 Key 留空时沿用上面的 LLM_BASE_URL / LLM_API_KEY）
# VISION_MODEL=
# VISION_BASE_URL=
# VISION_API_KEY=
# 附加参数（JSON），留空沿用 LLM_EXTRA_BODY
# VISION_EXTRA_BODY={"enable_thinking": false}
# 图片传给模型的方式：auto（OSS / COS 用签名地址，本地存储用 base64）/ url / base64
# VISION_IMAGE_MODE=auto
# VISION_MAX_IMAGES=6


# 相似题语义检索（可选，不填只用字面相似度）；地址与 Key 默认沿用上面的大模型配置
# EMBEDDING_MODEL=text-embedding-v4
# 自动入库（默认开启）：解析完成后确定的题直接存入校本题库，只有不确定的题留给人工审核。
# 不确定：置信度低于阈值、题干为空、公式未识别、缺少答案、AI 答案待确认、疑似重复，或整份试卷已在试卷库中
# 已解析的试卷补做：uv run python -m app.auto_commit --all（加 --dry-run 只统计）
# AUTO_COMMIT=true
# AUTO_COMMIT_MIN_CONFIDENCE=0.8
# 原卷没有答案时也自动入库，可设为 false（之后可在题库中用 AI 生成答案）
# AUTO_COMMIT_REQUIRE_ANSWER=true
# 规则拆题（未配置大模型，或大模型额度用完等降级）的试卷也自动入库，默认留给人工审核
# AUTO_COMMIT_RULE_ONLY=false
# 每个进程同时执行的任务数（解析、生成答案等；批量上传时其余排队）
# 1–10；线程池与数据库连接池自动随之放大。实际上限还取决于 MinerU 与大模型接口的限流
# WORKER_CONCURRENCY=2
# 任务队列（可选）：配置后由独立 Worker 进程执行任务，可同时运行多个：uv run python -m app.worker
# 未配置时任务在网页服务进程内执行。docker compose 部署时自动连接其中的 Redis，这里不必填写
# REDIS_URL=redis://localhost:6380/0

# 模型单价：Worker 每 PRICE_REFRESH_HOURS 小时（0 为不抓取）从百炼官方定价页抓取（按 PRICE_REGION / PRICE_SCOPE，
# 与 LLM_BASE_URL 所在工作空间一致），页面上没有的模型用 OpenRouter 列表价补充；价格变化时写入一条新记录，
# 每次调用按当时的单价计算定价成本写入 ai_usage。查看与补算：uv run python -m app.pricing --show / --refresh / --backfill
# PRICE_REFRESH_HOURS=24
# PRICE_SOURCES=["aliyun","openrouter"]
# PRICE_REGION=Singapore
# PRICE_SCOPE=International
# 缓存命中的输入 token 按输入单价的比例计费（百炼隐式缓存 20%，部分模型 10%）
# LLM_CACHE_HIT_RATIO=0.2
# LLM_MODEL_CACHE_RATIO={"deepseek-v4.1-flash":0.1}
# 手动单价（可选，优先于在线单价，货币为 CURRENCY）。请以厂商官网价格为准。
# 大模型按模型名配置，单位：元 / 百万 tokens；cached_input 为缓存命中的输入单价（不填按 input 计）
# LLM_PRICES={"qwen-plus": {"input": 0.8, "output": 2, "cached_input": 0.16}}
# MinerU 单价，单位：元 / 页
# MINERU_PRICE_PER_PAGE=0.05
# CURRENCY=¥

# 数据库（PostgreSQL）：不填时连接 docker compose 中的数据库（先 docker compose up -d db，本机 5433 端口）
# docker compose 部署时自动连接其中的数据库，这里的 DATABASE_URL 不生效（见 README「Docker 部署」）
# DATABASE_URL=postgresql+psycopg://fg_quiz:fg-quiz-local@127.0.0.1:5433/fg_quiz?sslmode=disable
# 远程库建议使用 ?sslmode=require
# 数据目录（本地存储时的上传文件、页面图、题目配图）
# DATA_DIR=./data

# 文件存储：local（DATA_DIR/storage）、oss（阿里云 OSS）或 cos（腾讯云 COS）；用对象存储时 app 与各 Worker 可部署在不同机器
# 从本地切换到对象存储：先 uv run python -m app.migrate_storage --to cos 上传已有文件，再修改 STORAGE_BACKEND
# STORAGE_BACKEND=cos
# 签名地址有效期（秒）：浏览器直传 / 查看配图时的跳转
# STORAGE_UPLOAD_EXPIRES=1800
# STORAGE_URL_EXPIRES=600

# 腾讯云 COS（STORAGE_BACKEND=cos）
# Bucket 名称带 APPID，如 fg-quiz-1250000000；地域如 ap-guangzhou、ap-shanghai、ap-beijing
# 默认域名在同地域的腾讯云服务器（CVM / 轻量 / 容器）上自动走内网，无需单独配置内网地址
# COS_BUCKET=
# COS_REGION=ap-guangzhou
# 建议使用只授权该 Bucket 读写的 CAM 子用户密钥：https://console.cloud.tencent.com/cam/capi
# COS_SECRET_ID=
# COS_SECRET_KEY=
# 对象名前缀，多套环境共用 Bucket 时区分
# COS_PREFIX=fg-quiz/prod

# 阿里云 OSS（STORAGE_BACKEND=oss）
# OSS_BUCKET=
# OSS_REGION=cn-hangzhou
# 服务端读写的 Endpoint，留空为该地域公网地址；同地域 ECS 可用内网：oss-cn-hangzhou-internal.aliyuncs.com
# OSS_ENDPOINT=
# 使用内网 OSS_ENDPOINT 时必填：签名地址给浏览器和大模型用，须为公网地址，如 oss-cn-hangzhou.aliyuncs.com
# OSS_PUBLIC_ENDPOINT=
# 建议使用只授权该 Bucket 读写的 RAM 子账号 AccessKey
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# 对象名前缀，多套环境共用 Bucket 时区分
# OSS_PREFIX=fg-quiz/prod

# 可选：libpq 标准变量，供 psql / pg_dump 等命令行工具使用。
# 注意：进入进程环境变量时（如 docker compose 的 env_file）也会影响应用的数据库连接，
# 例如 PGSSLMODE 会作用于没有在地址中写明 sslmode 的连接
# 用法：set -a; source .env; set +a; psql
# PGHOST=
# PGPORT=5432
# PGDATABASE=
# PGUSER=
# PGPASSWORD=
# PGSSLMODE=require

# 登录会话（HTTPS 部署必须开启 COOKIE_SECURE；本地 HTTP 开发保持 false）
SESSION_HOURS=12
COOKIE_SECURE=false
